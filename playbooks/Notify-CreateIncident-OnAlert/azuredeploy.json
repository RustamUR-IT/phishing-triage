{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Notify-CreateIncident-OnAlert",
    "description": "Runs on a Microsoft Sentinel alert. Creates (or updates) a Sentinel incident for the alert when its severity reaches a threshold, links the alert to it, and sends an e-mail and optional Microsoft Teams notification with the alert details and incident link.",
    "prerequisites": "A Microsoft Sentinel workspace in the resource group you deploy to. After deployment, authorize the Office 365 connection once.",
    "lastUpdateTime": "2026-11-11T00:00:00Z",
    "entities": [],
    "tags": ["Notification", "Incident", "Phishing"],
    "support": { "tier": "community" },
    "author": { "name": "phishing-triage" }
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "Notify-CreateIncident-OnAlert",
      "metadata": { "description": "Name of the Logic App." }
    },
    "WorkspaceName": {
      "type": "string",
      "metadata": { "description": "Log Analytics workspace with Microsoft Sentinel. Must be in the resource group you deploy to." }
    },
    "NotificationRecipients": {
      "type": "string",
      "metadata": { "description": "E-mail recipients, separated by semicolons (e.g. soc@example.com;oncall@example.com)." }
    },
    "TeamsWebhookUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Optional. Teams 'Workflows' webhook URL for a channel. Leave empty to send e-mail only." }
    },
    "CreateIncident": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "Create a Sentinel incident for the alert. Turn off if the analytics rule already creates incidents." }
    },
    "MinimumIncidentSeverity": {
      "type": "string",
      "defaultValue": "Medium",
      "allowedValues": ["Informational", "Low", "Medium", "High"],
      "metadata": { "description": "Alerts below this severity are only notified, no incident is created." }
    },
    "AssignSentinelResponderRole": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "Grant the playbook's managed identity 'Microsoft Sentinel Responder' on the workspace. Requires Owner or User Access Administrator; turn off and assign it manually otherwise." }
    }
  },
  "variables": {
    "sentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "office365ConnectionName": "[concat('office365-', parameters('PlaybookName'))]",
    "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
    "sentinelResponderRoleId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('office365ConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('office365ConnectionName')]",
        "customParameterValues": {},
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'office365')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-SentinelTemplateName": "Notify-CreateIncident-OnAlert",
        "hidden-SentinelTemplateVersion": "1.0"
      },
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'azuresentinel')]",
                "connectionProperties": {
                  "authentication": { "type": "ManagedServiceIdentity" }
                }
              },
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('office365ConnectionName'))]",
                "connectionName": "[variables('office365ConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'office365')]"
              }
            }
          },
          "workspaceResourceId": { "value": "[variables('workspaceResourceId')]" },
          "notificationRecipients": { "value": "[parameters('NotificationRecipients')]" },
          "teamsWebhookUrl": { "value": "[parameters('TeamsWebhookUrl')]" },
          "createIncident": { "value": "[parameters('CreateIncident')]" },
          "minimumIncidentSeverity": { "value": "[parameters('MinimumIncidentSeverity')]" }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "type": "Object", "defaultValue": {} },
            "workspaceResourceId": { "type": "String" },
            "notificationRecipients": { "type": "String" },
            "teamsWebhookUrl": { "type": "SecureString", "defaultValue": "" },
            "createIncident": { "type": "Bool", "defaultValue": true },
            "minimumIncidentSeverity": { "type": "String", "defaultValue": "Medium" }
          },
          "triggers": {
            "Microsoft_Sentinel_alert": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "body": { "callback_url": "@{listCallbackUrl()}" },
                "path": "/subscribe"
              }
            }
          },
          "actions": {
            "Initialize_IncidentUrl": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [{ "name": "IncidentUrl", "type": "string", "value": "" }]
              }
            },
            "Initialize_IncidentNumber": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_IncidentUrl": ["Succeeded"] },
              "inputs": {
                "variables": [{ "name": "IncidentNumber", "type": "string", "value": "" }]
              }
            },
            "Severity_rank": {
              "type": "Compose",
              "runAfter": { "Initialize_IncidentNumber": ["Succeeded"] },
              "inputs": "@if(equals(triggerBody()?['Severity'], 'High'), 3, if(equals(triggerBody()?['Severity'], 'Medium'), 2, if(equals(triggerBody()?['Severity'], 'Low'), 1, 0)))"
            },
            "Minimum_rank": {
              "type": "Compose",
              "runAfter": { "Severity_rank": ["Succeeded"] },
              "inputs": "@if(equals(parameters('minimumIncidentSeverity'), 'High'), 3, if(equals(parameters('minimumIncidentSeverity'), 'Medium'), 2, if(equals(parameters('minimumIncidentSeverity'), 'Low'), 1, 0)))"
            },
            "Create_incident_if_severe_enough": {
              "type": "If",
              "runAfter": { "Minimum_rank": ["Succeeded"] },
              "expression": {
                "and": [
                  { "equals": ["@parameters('createIncident')", true] },
                  { "greaterOrEquals": ["@outputs('Severity_rank')", "@outputs('Minimum_rank')"] }
                ]
              },
              "actions": {
                "Create_incident": {
                  "type": "Http",
                  "runAfter": {},
                  "description": "PUT with the alert ID as incident ID: a re-run updates the same incident instead of creating a duplicate.",
                  "inputs": {
                    "method": "PUT",
                    "uri": "https://management.azure.com@{parameters('workspaceResourceId')}/providers/Microsoft.SecurityInsights/incidents/@{triggerBody()?['SystemAlertId']}?api-version=2024-03-01",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://management.azure.com/"
                    },
                    "body": {
                      "properties": {
                        "title": "@{triggerBody()?['AlertDisplayName']}",
                        "severity": "@{triggerBody()?['Severity']}",
                        "status": "New",
                        "description": "@{coalesce(triggerBody()?['Description'], '')}\n\nCreated automatically by playbook @{workflow()?['name']} from alert @{triggerBody()?['SystemAlertId']} (@{triggerBody()?['ProductName']}).",
                        "labels": [
                          { "labelName": "auto-created", "labelType": "User" }
                        ]
                      }
                    }
                  }
                },
                "Link_alert_to_incident": {
                  "type": "Http",
                  "runAfter": { "Create_incident": ["Succeeded"] },
                  "inputs": {
                    "method": "PUT",
                    "uri": "https://management.azure.com@{parameters('workspaceResourceId')}/providers/Microsoft.SecurityInsights/incidents/@{triggerBody()?['SystemAlertId']}/relations/@{triggerBody()?['SystemAlertId']}?api-version=2024-03-01",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://management.azure.com/"
                    },
                    "body": {
                      "properties": {
                        "relatedResourceId": "@{parameters('workspaceResourceId')}/providers/Microsoft.SecurityInsights/entities/@{triggerBody()?['SystemAlertId']}"
                      }
                    }
                  }
                },
                "Set_IncidentUrl": {
                  "type": "SetVariable",
                  "runAfter": { "Create_incident": ["Succeeded"] },
                  "inputs": {
                    "name": "IncidentUrl",
                    "value": "@{body('Create_incident')?['properties']?['incidentUrl']}"
                  }
                },
                "Set_IncidentNumber": {
                  "type": "SetVariable",
                  "runAfter": { "Set_IncidentUrl": ["Succeeded"] },
                  "inputs": {
                    "name": "IncidentNumber",
                    "value": "@{body('Create_incident')?['properties']?['incidentNumber']}"
                  }
                }
              },
              "else": { "actions": {} }
            },
            "Send_email_notification": {
              "type": "ApiConnection",
              "runAfter": {
                "Create_incident_if_severe_enough": ["Succeeded", "Failed", "TimedOut"]
              },
              "description": "Runs even if incident creation failed: the SOC must hear about the alert either way.",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@parameters('notificationRecipients')",
                  "Subject": "Sentinel alert (@{triggerBody()?['Severity']}): @{triggerBody()?['AlertDisplayName']}",
                  "Importance": "@{if(equals(triggerBody()?['Severity'], 'High'), 'High', 'Normal')}",
                  "Body": "<h2>@{triggerBody()?['AlertDisplayName']}</h2><table><tr><td><b>Severity</b></td><td>@{triggerBody()?['Severity']}</td></tr><tr><td><b>Product</b></td><td>@{triggerBody()?['ProductName']}</td></tr><tr><td><b>Start (UTC)</b></td><td>@{triggerBody()?['StartTimeUtc']}</td></tr><tr><td><b>Compromised entity</b></td><td>@{coalesce(triggerBody()?['CompromisedEntity'], '-')}</td></tr><tr><td><b>Alert ID</b></td><td>@{triggerBody()?['SystemAlertId']}</td></tr><tr><td><b>Incident</b></td><td>@{if(empty(variables('IncidentUrl')), 'not created by this playbook', concat('<a href=\"', variables('IncidentUrl'), '\">#', variables('IncidentNumber'), '</a>'))}</td></tr></table><p>@{coalesce(triggerBody()?['Description'], '')}</p><p><i>Sent by playbook @{workflow()?['name']}.</i></p>"
                }
              }
            },
            "Post_to_Teams_if_configured": {
              "type": "If",
              "runAfter": { "Send_email_notification": ["Succeeded", "Failed", "TimedOut"] },
              "expression": {
                "and": [{ "not": { "equals": ["@parameters('teamsWebhookUrl')", ""] } }]
              },
              "actions": {
                "Post_Teams_message": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('teamsWebhookUrl')",
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "type": "message",
                      "attachments": [
                        {
                          "contentType": "application/vnd.microsoft.card.adaptive",
                          "content": {
                            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                            "type": "AdaptiveCard",
                            "version": "1.4",
                            "body": [
                              {
                                "type": "TextBlock",
                                "size": "Large",
                                "weight": "Bolder",
                                "wrap": true,
                                "color": "@{if(equals(triggerBody()?['Severity'], 'High'), 'Attention', if(equals(triggerBody()?['Severity'], 'Medium'), 'Warning', 'Default'))}",
                                "text": "Sentinel alert: @{triggerBody()?['AlertDisplayName']}"
                              },
                              {
                                "type": "FactSet",
                                "facts": [
                                  { "title": "Severity", "value": "@{triggerBody()?['Severity']}" },
                                  { "title": "Product", "value": "@{triggerBody()?['ProductName']}" },
                                  { "title": "Start (UTC)", "value": "@{triggerBody()?['StartTimeUtc']}" },
                                  { "title": "Entity", "value": "@{coalesce(triggerBody()?['CompromisedEntity'], '-')}" },
                                  { "title": "Alert ID", "value": "@{triggerBody()?['SystemAlertId']}" }
                                ]
                              },
                              {
                                "type": "TextBlock",
                                "wrap": true,
                                "text": "@{if(empty(variables('IncidentUrl')), 'No incident created by this playbook.', concat('Incident: [#', variables('IncidentNumber'), '](', variables('IncidentUrl'), ')'))}"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "else": { "actions": {} }
            }
          },
          "outputs": {}
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[parameters('AssignSentinelResponderRole')]",
      "name": "[guid(variables('workspaceResourceId'), resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), variables('sentinelResponderRoleId'))]",
      "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('WorkspaceName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelResponderRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "playbookPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}
