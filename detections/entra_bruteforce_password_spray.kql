// Title:        Entra ID brute force or password spray from one IP, with follow-up success
// ATT&CK:       T1110.001, T1110.003
// Tactics:      CredentialAccess
// Severity:     Medium; High when a targeted account then signs in from the same IP (Severity column)
// Data sources: SigninLogs, AADNonInteractiveUserSignInLogs (Microsoft Entra ID connector)
// Schedule:     run every 1h, look back 1h, alert when results > 0, one alert per row
// Entities:     Account = AccountUpn, IP = IPAddress
// Description:  Groups failed Entra ID sign-ins by source IP. Many failures against a few
//               accounts is brute force (T1110.001), failures spread over many accounts is
//               password spraying (T1110.003). If one of the targeted accounts later signs in
//               successfully from the same IP, the password was probably guessed.
// Tuning:       Put corporate egress / VPN / proxy IPs in trustedIps: shared NAT addresses
//               collect failures from many users and look like a spray. Raise the thresholds
//               if legacy clients with stale passwords create noise.
// Limits:       Attacks rotating source IPs (one attempt per IP) are not caught here; that
//               needs a per-account view across IPs.
let lookback = 1h;
let bruteForceMinFailures = 20;  // failed attempts against at most 3 accounts from one IP
let sprayMinAccounts = 10;       // distinct accounts with failed attempts from one IP
// 50126 invalid username or password, 50053 locked (smart lockout), 50056 invalid or null
// password, 50064 credential validation failed
let failureCodes = dynamic(["50126", "50053", "50056", "50064"]);
let trustedIps = dynamic([]);
let signins = union isfuzzy=true
        (SigninLogs
        | project TimeGenerated, UserPrincipalName, IPAddress, ResultType, AppDisplayName,
            ClientAppUsed, UserAgent, Location),
        (AADNonInteractiveUserSignInLogs
        | project TimeGenerated, UserPrincipalName, IPAddress, ResultType, AppDisplayName,
            ClientAppUsed, UserAgent, Location)
    | where TimeGenerated > ago(lookback)
    | where isnotempty(IPAddress) and IPAddress !in (trustedIps)
    | extend UserPrincipalName = tolower(UserPrincipalName);
let attackers = signins
    | where ResultType in (failureCodes)
    | summarize
        FailedAttempts = count(),
        TargetedAccounts = dcount(UserPrincipalName),
        FailedAccounts = make_set(UserPrincipalName, 1000),
        Apps = make_set(AppDisplayName, 10),
        ClientApps = make_set(ClientAppUsed, 10),
        UserAgents = make_set(UserAgent, 5),
        Locations = make_set(Location, 5),
        FirstFailure = min(TimeGenerated),
        LastFailure = max(TimeGenerated)
        by IPAddress
    | extend Pattern = case(
        TargetedAccounts >= sprayMinAccounts, "Password spray (T1110.003)",
        FailedAttempts >= bruteForceMinFailures and TargetedAccounts <= 3, "Brute force (T1110.001)",
        "")
    | where isnotempty(Pattern);
// Successful sign-in of an attacked account, from the attacking IP, after the first failure
let successes = signins
    | where ResultType == "0"
    | join kind=inner (attackers | project IPAddress, FirstFailure, FailedAccounts) on IPAddress
    | where TimeGenerated > FirstFailure and set_has_element(FailedAccounts, UserPrincipalName)
    | summarize
        CompromisedAccounts = make_set(UserPrincipalName, 100),
        FirstSuccess = min(TimeGenerated)
        by IPAddress;
attackers
| join kind=leftouter successes on IPAddress
| extend CompromisedCount = coalesce(array_length(CompromisedAccounts), 0)
| extend
    Severity = iff(CompromisedCount > 0, "High", "Medium"),
    AccountUpn = iff(CompromisedCount > 0, tostring(CompromisedAccounts[0]), tostring(FailedAccounts[0]))
| project
    FirstFailure, LastFailure, IPAddress, Pattern, Severity, FailedAttempts, TargetedAccounts,
    CompromisedCount, CompromisedAccounts, FirstSuccess, AccountUpn,
    TargetedAccountSample = array_slice(FailedAccounts, 0, 24),
    Apps, ClientApps, UserAgents, Locations
| order by CompromisedCount desc, FailedAttempts desc
